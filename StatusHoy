<style>
  .status-hoy-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-left: 30px;
    min-width: 80px;
  }

  .status-hoy-titulo {
    font-size: 11px;
    font-weight: 800;
    color: #555555;
    margin-bottom: 5px;
    white-space: nowrap;
  }

  .status-icon-wrapper {
    font-size: 32px;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 40px;
  }

  /* Animación para la palomita verde */
  .check-anim {
    color: #2ECC71;
    filter: drop-shadow(0 0 8px #2ecc71);
    animation: bounceIn 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  /* Animación para el SOS Rojo Neon */
  .sos-anim {
    color: #FF3131;
    font-weight: 900;
    font-size: 24px;
    text-shadow: 0 0 5px #ff3131, 0 0 10px #ff3131, 0 0 20px #ff3131;
    animation: blinkNeon 1.5s infinite alternate;
  }

  @keyframes bounceIn {
    0% { transform: scale(0.1); opacity: 0; }
    60% { transform: scale(1.2); opacity: 1; }
    100% { transform: scale(1); }
  }

  @keyframes blinkNeon {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.05); text-shadow: 0 0 10px #ff3131, 0 0 30px #ff3131; }
  }
</style>

<div class="status-hoy-container" id="seccionStatusHoy" style="display:none;">
  <div class="status-hoy-titulo">Status Hoy</div>
  <div class="status-icon-wrapper" id="statusContent"></div>
</div>

<script>
  function actualizarStatusHoy(ventaG, ventaCorte) {
    const contenedor = document.getElementById('seccionStatusHoy');
    const content = document.getElementById('statusContent');
    
    contenedor.style.display = 'flex';
    
    if (ventaG >= ventaCorte) {
      // Palomita Verde con sombra sutil
      content.innerHTML = '<span class="check-anim">✔</span>';
    } else {
      // SOS Rojo Neon
      content.innerHTML = '<span class="sos-anim">SOS</span>';
    }
  }
</script>
