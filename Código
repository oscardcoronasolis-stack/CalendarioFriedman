function obtenerDatos() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('dataset');
  
  // Obtenemos la última fila con datos
  const ultimaFila = sheet.getLastRow();
  
  // Forzamos la lectura: desde fila 1, columna 1, hasta últimaFila, columna 20 (T)
  // getRange(fila inicial, columna inicial, número de filas, número de columnas)
  const rango = sheet.getRange(1, 1, ultimaFila, 20); 
  
  const valores = rango.getDisplayValues();
  
  // LOG DE SEGURIDAD: Esto lo verás en el registro de ejecuciones
  console.log("Columnas leídas: " + valores[0].length); // Debería decir 20
  
  return valores;
}

